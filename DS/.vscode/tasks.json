{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build task_manager",
            "type": "process",
            "command": "C:\\MinGW\\bin\\gcc.exe",
            "args": [
                "-std=c11",
                "-Wall",
                "-Wextra",
                "-pedantic",
                "${workspaceFolder}\\task_manager.c",
                "-o",
                "${workspaceFolder}\\task_manager.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Run task_manager",
            "type": "process",
            "command": "${workspaceFolder}\\task_manager.exe",
            "dependsOn": "Build task_manager",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
